          "expr": "sum by (limit, tenant) (increase(communication_limit_rejected_total{app=\"fint-communication-service\", tenant=~\"$tenant\"}[5m]))",
          "legendFormat": "{{limit}} {{tenant}}"
        }
      ]
    },
